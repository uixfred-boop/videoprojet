{%- comment -%}
  Stylised Day Up bottle (SVG). Used when no transparent packshot is uploaded.
  Params: class, style, flavor (label line), count (label line)
{%- endcomment -%}
{%- assign flavor = flavor | default: 'GOÛT POMME' -%}
{%- assign count = count | default: '60 GUMMIES' -%}
<svg class="bottle {{ class }}" {% if style %}style="{{ style }}"{% endif %} viewBox="0 0 200 330" role="img" aria-label="Day Up Daily Energy Gummies">
  <ellipse cx="100" cy="322" rx="74" ry="7" fill="#0a1f44" opacity=".16"/>
  <rect x="58" y="60" width="84" height="22" rx="5" fill="#dcecf9"/>
  <rect x="20" y="74" width="160" height="246" rx="38" fill="url(#du-bottle-body)" stroke="#8fbfe6" stroke-opacity=".55" stroke-width="1.5"/>
  <g class="bottle__gummies">
    <ellipse cx="62" cy="112" rx="15" ry="12" fill="url(#du-gummy-body)"/>
    <ellipse cx="96" cy="104" rx="15" ry="12" fill="url(#du-gummy-body)"/>
    <ellipse cx="132" cy="114" rx="15" ry="12" fill="url(#du-gummy-body)"/>
    <ellipse cx="80" cy="126" rx="15" ry="11" fill="url(#du-gummy-body)"/>
    <ellipse cx="116" cy="128" rx="15" ry="11" fill="url(#du-gummy-body)"/>
    <ellipse cx="58" cy="292" rx="15" ry="12" fill="url(#du-gummy-body)"/>
    <ellipse cx="94" cy="298" rx="15" ry="12" fill="url(#du-gummy-body)"/>
    <ellipse cx="130" cy="292" rx="15" ry="12" fill="url(#du-gummy-body)"/>
    <ellipse cx="148" cy="300" rx="10" ry="9" fill="url(#du-gummy-body)"/>
  </g>
  <rect x="20.5" y="138" width="159" height="138" fill="url(#du-label)"/>
  <rect x="20.5" y="138" width="159" height="5" class="bottle__accent"/>
  <rect x="20.5" y="271" width="159" height="5" class="bottle__accent"/>
  <g class="bottle__sun" transform="translate(88 150)" fill="none" stroke-width="2" stroke-linecap="round">
    <path d="M3 14a9 9 0 0 1 18 0M0 14h24M12 1v3M3.5 5l2 2M20.5 5l-2 2"/>
  </g>
  <text x="100" y="202" text-anchor="middle" class="bottle__brand">DAY</text>
  <text x="100" y="240" text-anchor="middle" class="bottle__brand">UP!</text>
  <text x="100" y="256" text-anchor="middle" class="bottle__sub">DAILY ENERGY</text>
  <text x="100" y="267" text-anchor="middle" class="bottle__micro">{{ count }} · {{ flavor }}</text>
  <rect x="34" y="88" width="11" height="222" rx="5.5" fill="#fff" opacity=".5"/>
  <rect x="150" y="96" width="6" height="200" rx="3" fill="#fff" opacity=".28"/>
  <rect x="50" y="8" width="100" height="58" rx="12" fill="url(#du-bottle-cap)" stroke="#c9d2dc" stroke-width="1"/>
  <g stroke="#d5dce4" stroke-width="2">
    {%- for i in (0..13) -%}
      {%- assign x = i | times: 6 | plus: 61 -%}
      <path d="M{{ x }} 14v40"/>
    {%- endfor -%}
  </g>
  <rect x="50" y="54" width="100" height="10" rx="4" fill="#e9eef3"/>
  <rect x="62" y="12" width="8" height="42" rx="4" fill="#fff" opacity=".9"/>
</svg>
