{%- liquid
  assign networks = 'instagram,tiktok,youtube,facebook,snapchat' | split: ','
  assign has_any = false
  for n in networks
    assign key = 'social_' | append: n
    if settings[key] != blank
      assign has_any = true
    endif
  endfor
-%}
{%- if has_any -%}
  <ul class="socials {{ class }}" role="list">
    {%- for n in networks -%}
      {%- assign key = 'social_' | append: n -%}
      {%- if settings[key] != blank -%}
        <li><a href="{{ settings[key] }}" target="_blank" rel="noopener" aria-label="{{ n | capitalize }}">{% render 'icon', name: n, size: 18 %}</a></li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
{%- endif -%}
