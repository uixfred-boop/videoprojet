{%- comment -%}
  Renders an inline SVG icon.
  Usage: {% render 'icon', name: 'check', size: 20, class: 'foo' %}
{%- endcomment -%}
{%- assign s = size | default: 24 -%}
{%- capture attrs -%}width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false" class="icon icon--{{ name }} {{ class }}"{%- endcapture -%}
{%- case name -%}
  {%- when 'check' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 12.5l4.8 4.8L19.5 7"/></svg>
  {%- when 'check-circle' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M7.5 12.3l3 3 6-6.3"/></svg>
  {%- when 'check-badge' -%}
    <svg {{ attrs }} fill="currentColor"><circle cx="12" cy="12" r="11"/><path d="M7 12.4l3.2 3.2L17.2 8.6" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'x-badge' -%}
    <svg {{ attrs }} fill="currentColor"><circle cx="12" cy="12" r="11"/><path d="M8.5 8.5l7 7M15.5 8.5l-7 7" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/></svg>
  {%- when 'tilde-badge' -%}
    <svg {{ attrs }} fill="currentColor"><circle cx="12" cy="12" r="11"/><path d="M7 13c1.4-2 2.9-2 4.4-.8 1.6 1.2 3.1 1.2 4.6-.9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/></svg>
  {%- when 'plus' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M12 4v16M4 12h16"/></svg>
  {%- when 'minus' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 12h16"/></svg>
  {%- when 'close' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
  {%- when 'bag' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M5 8h14l-1 12.2a1 1 0 0 1-1 .8H7a1 1 0 0 1-1-.8L5 8z"/><path d="M9 10V6.5a3 3 0 0 1 6 0V10" stroke-linecap="round"/></svg>
  {%- when 'menu' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 9h16M4 15h16"/></svg>
  {%- when 'arrow-right' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
  {%- when 'chevron-down' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
  {%- when 'star' -%}
    <svg {{ attrs }} fill="currentColor"><path d="M12 2.6l2.9 6 6.5.8-4.8 4.5 1.2 6.5L12 17.2l-5.8 3.2 1.2-6.5L2.6 9.4l6.5-.8L12 2.6z"/></svg>
  {%- when 'shield' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 2.8l7.5 3v5.6c0 4.6-3.2 8.3-7.5 9.8-4.3-1.5-7.5-5.2-7.5-9.8V5.8l7.5-3z"/><path d="M8.6 12l2.4 2.4 4.4-4.6" stroke-linecap="round"/></svg>
  {%- when 'lock' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><rect x="4.5" y="10.5" width="15" height="10.5" rx="2.5"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3" stroke-linecap="round"/><circle cx="12" cy="15.7" r="1.3" fill="currentColor"/></svg>
  {%- when 'truck' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M2.5 6.5h11v9.5h-11zM13.5 9.5h4l3 3.2v3.3h-7z"/><circle cx="6.5" cy="17.5" r="1.8" fill="var(--icon-fill, #fff)"/><circle cx="17" cy="17.5" r="1.8" fill="var(--icon-fill, #fff)"/></svg>
  {%- when 'guarantee' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 1 1-2.3-5.7"/><path d="M20 4.5v4h-4"/><path d="M8.5 12.2l2.4 2.4 4.6-4.8"/></svg>
  {%- when 'calendar' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/><path d="M8 13.5h.01M12 13.5h.01M16 13.5h.01M8 17h.01M12 17h.01" stroke-width="2.4"/></svg>
  {%- when 'refresh' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12a8 8 0 0 1 13.7-5.6L20 8.5M20 4v4.5h-4.5M20 12a8 8 0 0 1-13.7 5.6L4 15.5M4 20v-4.5h4.5"/></svg>
  {%- when 'bolt' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M13.5 2.5L5 13.5h6l-1 8 8.5-11h-6l1-8z"/></svg>
  {%- when 'leaf' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 19c0-8 5-13.5 15-14-0.5 10-6 15-14 15"/><path d="M5 19c3-4.5 6-7 9.5-9"/></svg>
  {%- when 'brain' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 4.5a3 3 0 0 0-3 3 3 3 0 0 0-2 5.2A3.2 3.2 0 0 0 6.5 18 3 3 0 0 0 12 19.5v-13A3 3 0 0 0 9 4.5z"/><path d="M15 4.5a3 3 0 0 1 3 3 3 3 0 0 1 2 5.2 3.2 3.2 0 0 1-2.5 5.3A3 3 0 0 1 12 19.5"/><path d="M12 9h-2M12 14h2.5"/></svg>
  {%- when 'flower' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="10" r="2.2"/><path d="M12 7.8c-1.6-3.6 1.6-5 1.6-2.2M14.2 10c3.6-1.6 5 1.6 2.2 1.6M12 12.2c1.6 3.6-1.6 5-1.6 2.2M9.8 10c-3.6 1.6-5-1.6-2.2-1.6"/><path d="M12 12.5V21M12 17c-2-2-4-2-5-1.5M12 18.5c2-2 4-2 5-1.5"/></svg>
  {%- when 'apple' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 7.5c-2-1.6-6.5-1.4-7 3.5-.4 4.5 2.6 10 5.3 10 .9 0 1.1-.5 1.7-.5s.8.5 1.7.5c2.7 0 5.7-5.5 5.3-10-.5-4.9-5-5.1-7-3.5z"/><path d="M12 7.5c0-2 .8-3.6 2.8-4.5"/><path d="M12.6 5.2c1.6-.2 2.8.4 3.4 1.6-1.6.4-2.8 0-3.4-1.6z" fill="currentColor"/></svg>
  {%- when 'no-sugar' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M6 9l6-3 6 3v7l-6 3-6-3z"/><path d="M6 9l6 3 6-3M12 12v7"/><path d="M4 4l16 16" stroke-linecap="round"/></svg>
  {%- when 'sun' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M5 17a7 7 0 0 1 14 0"/><path d="M2.5 17h19M12 4.5v3M5.2 7.6l2 2M18.8 7.6l-2 2M2.8 12.5h2M19.2 12.5h2"/></svg>
  {%- when 'target' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="11" cy="13" r="8"/><circle cx="11" cy="13" r="4.5"/><circle cx="11" cy="13" r="1.2" fill="currentColor"/><path d="M11 13l8.5-8.5M16.5 4.5h3v3"/></svg>
  {%- when 'smile' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="9.5"/><path d="M8 14.2c1.8 2.4 6.2 2.4 8 0"/><path d="M9 9.5h.01M15 9.5h.01" stroke-width="2.6"/></svg>
  {%- when 'pill' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2.8" y="8.2" width="18.4" height="7.6" rx="3.8" transform="rotate(-35 12 12)"/><path d="M9.5 8.3l5 7.4" transform="rotate(0 12 12)"/></svg>
  {%- when 'tag' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M3.5 12.2V4.5a1 1 0 0 1 1-1h7.7l8.3 8.3a1 1 0 0 1 0 1.4l-7.1 7.1a1 1 0 0 1-1.4 0l-8.5-8.1z"/><circle cx="8" cy="8" r="1.4" fill="currentColor"/></svg>
  {%- when 'play' -%}
    <svg {{ attrs }} fill="currentColor"><path d="M8 5.5v13l10.5-6.5z"/></svg>
  {%- when 'volume' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor"/><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"/></svg>
  {%- when 'mute' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor"/><path d="M16 9.5l5 5M21 9.5l-5 5"/></svg>
  {%- when 'mail' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/></svg>
  {%- when 'instagram' -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg>
  {%- when 'tiktok' -%}
    <svg {{ attrs }} fill="currentColor"><path d="M16.6 3c.3 2.3 1.7 3.9 4 4.1v3.1c-1.5.1-2.8-.4-4-1.2v6.1c0 3.6-2.7 5.9-5.9 5.9-3.4 0-5.9-2.8-5.6-6.2.3-3.1 3.1-5.4 6.3-5v3.2c-1.5-.3-3 .6-3.2 2.1-.2 1.5.9 2.8 2.4 2.8 1.4 0 2.6-1 2.6-2.7V3h3.4z"/></svg>
  {%- when 'youtube' -%}
    <svg {{ attrs }} fill="currentColor"><path d="M21.6 7.2a2.6 2.6 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.6 2.6 0 0 0 2.4 7.2 27 27 0 0 0 2 12a27 27 0 0 0 .4 4.8 2.6 2.6 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.6 2.6 0 0 0 1.8-1.8A27 27 0 0 0 22 12a27 27 0 0 0-.4-4.8zM10 15.1V8.9l5.2 3.1L10 15.1z"/></svg>
  {%- when 'facebook' -%}
    <svg {{ attrs }} fill="currentColor"><path d="M13.5 21v-7.6h2.6l.4-3h-3V8.5c0-.9.3-1.5 1.5-1.5h1.6V4.3c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1z"/></svg>
  {%- when 'snapchat' -%}
    <svg {{ attrs }} fill="currentColor"><path d="M12 3c3 0 5 2.2 5 5v2.3c.6.2 1.2-.2 1.6.1.5.4-.1 1.1-1.3 1.6-.3.1-.5.4-.4.7.5 1.4 1.7 2.7 3.2 3.1.4.1.4.6-.1.8-.8.3-1.7.4-1.9.7-.1.3-.1.9-.5 1-.6.1-1.5-.3-2.6.1-1 .4-1.6 1.6-3 1.6s-2-1.2-3-1.6c-1.1-.4-2-.0-2.6-.1-.4-.1-.4-.7-.5-1-.2-.3-1.1-.4-1.9-.7-.5-.2-.5-.7-.1-.8 1.5-.4 2.7-1.7 3.2-3.1.1-.3-.1-.6-.4-.7-1.2-.5-1.8-1.2-1.3-1.6.4-.3 1-.1 1.6-.1V8c0-2.8 2-5 5-5z"/></svg>
  {%- else -%}
    <svg {{ attrs }} fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/></svg>
{%- endcase -%}
