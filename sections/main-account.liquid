<section class="page-section"><div class="page-width page-width--narrow account">
  <h1 class="display page-title">{{ 'customer.account' | t }}</h1>
  <p>{{ customer.first_name }} {{ customer.last_name }} · {{ customer.email }} · <a href="{{ routes.account_logout_url }}">{{ 'customer.logout' | t }}</a></p>
  <h2 class="account__h2">{{ 'customer.orders' | t }}</h2>
  {%- paginate customer.orders by 20 -%}
    {%- if customer.orders.size > 0 -%}
      <table class="account__table"><thead><tr><th>{{ 'customer.order' | t }}</th><th>{{ 'customer.date' | t }}</th><th>{{ 'customer.status' | t }}</th><th>{{ 'customer.total' | t }}</th></tr></thead><tbody>
        {%- for order in customer.orders -%}
          <tr><td><a href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | date: '%d/%m/%Y' }}</td><td>{{ order.fulfillment_status_label }}</td><td>{{ order.total_price | money }}</td></tr>
        {%- endfor -%}
      </tbody></table>
    {%- else -%}<p>{{ 'customer.no_orders' | t }}</p>{%- endif -%}
    {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
  <p><a class="btn btn--outline" href="{{ routes.account_addresses_url }}">{{ 'customer.addresses' | t }} ({{ customer.addresses_count }})</a></p>
</div></section>

{% schema %}
{
  "name": "Compte",
  "settings": []
}
{% endschema %}
