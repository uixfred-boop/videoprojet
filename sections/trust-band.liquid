<section class="trust" style="--trust-bg: {{ section.settings.bg }};">
  <div class="trust__inner page-width">
    <div class="trust__intro">
      <h2 class="trust__title">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}<div class="trust__text">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <ul class="trust__tiles" role="list">
      {%- for block in section.blocks -%}
        <li class="trust__tile" {{ block.shopify_attributes }}>
          <span class="trust__icon">{% render 'icon', name: block.settings.icon, size: 26 %}</span>
          <span class="trust__value">{{ block.settings.value }}</span>
          <span class="trust__label">{{ block.settings.label }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Bande formule",
  "class": "section-trust",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Une formule claire, pensée pour tes journées chargées." },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Des actifs connus, des dosages affichés. Voici ce qui se cache dans tes gummies :</p>" },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#061A3D" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tuile",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icône", "default": "leaf", "options": [{ "value": "leaf", "label": "Feuille" }, { "value": "bolt", "label": "Éclair" }, { "value": "brain", "label": "Cerveau" }, { "value": "flower", "label": "Fleur" }, { "value": "pill", "label": "Gélule" }, { "value": "apple", "label": "Pomme" }, { "value": "no-sugar", "label": "Sans sucre" }, { "value": "shield", "label": "Bouclier" }, { "value": "sun", "label": "Soleil" }, { "value": "calendar", "label": "Calendrier" }] },
        { "type": "text", "id": "value", "label": "Valeur", "default": "200 mg" },
        { "type": "text", "id": "label", "label": "Libellé", "default": "Guarana" }
      ]
    }
  ],
  "presets": [{ "name": "Bande formule", "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }] }]
}
{% endschema %}
