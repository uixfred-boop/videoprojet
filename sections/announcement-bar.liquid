{%- if section.blocks.size > 0 -%}
<div class="announcement" style="--ann-bg: {{ section.settings.bg }}; --ann-fg: {{ section.settings.fg }}; --ann-accent: {{ section.settings.accent }};" data-rotator data-interval="{{ section.settings.interval | times: 1000 }}">
  <div class="announcement__track">
    {%- for block in section.blocks -%}
      <div class="announcement__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }} data-rotator-item>
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="announcement__link">{%- endif -%}
          {%- if block.settings.title != blank -%}<p class="announcement__title">{{ block.settings.title }}</p>{%- endif -%}
          {%- if block.settings.text != blank -%}<p class="announcement__text">{{ block.settings.text }}</p>{%- endif -%}
        {%- if block.settings.link != blank -%}</a>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Bandeau d'annonce",
  "class": "section-announcement",
  "max_blocks": 6,
  "settings": [
    { "type": "range", "id": "interval", "label": "Défilement (secondes)", "min": 3, "max": 10, "step": 1, "default": 5 },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#08224D" },
    { "type": "color", "id": "fg", "label": "Texte", "default": "#FFFFFF" },
    { "type": "color", "id": "accent", "label": "Titre", "default": "#FFC83D" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "title", "label": "Titre", "default": "⚡ Livraison offerte dès 50€ ⚡" },
        { "type": "text", "id": "text", "label": "Sous-titre", "default": "Garantie 14 jours satisfait ou remboursé" },
        { "type": "url", "id": "link", "label": "Lien" }
      ]
    }
  ],
  "presets": [{ "name": "Bandeau d'annonce", "blocks": [{ "type": "message" }] }]
}
{% endschema %}
