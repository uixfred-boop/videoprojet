<article class="page-section">
  <div class="page-width page-width--narrow">
    <p class="article__date">{{ article.published_at | date: '%d/%m/%Y' }}</p>
    <h1 class="display page-title">{{ article.title }}</h1>
    {%- if article.image -%}{{ article.image | image_url: width: 1400 | image_tag: class: 'article__img', alt: article.title }}{%- endif -%}
    <div class="rte">{{ article.content }}</div>
    <a class="btn btn--outline" href="{{ blog.url }}">{{ 'blog.back' | t }}</a>
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}
