<section class="page-section">
  <div class="page-width">
    <h1 class="display page-title">{{ blog.title }}</h1>
    {%- paginate blog.articles by 12 -%}
      <ul class="blog-grid" role="list">
        {%- for article in blog.articles -%}
          <li class="blog-card">
            <a href="{{ article.url }}">
              {%- if article.image -%}{{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: article.title, class: 'blog-card__img' }}{%- else -%}{% render 'pack-visual', packs: 1, class: 'blog-card__img' %}{%- endif -%}
              <span class="blog-card__date">{{ article.published_at | date: '%d/%m/%Y' }}</span>
              <span class="blog-card__title">{{ article.title }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": []
}
{% endschema %}
