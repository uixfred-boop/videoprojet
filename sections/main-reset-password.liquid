<section class="page-section"><div class="page-width page-width--narrow account">
  <h1 class="display page-title">{{ 'customer.reset' | t }}</h1>
  {%- form 'reset_customer_password', class: 'form' -%}
    {{ form.errors | default_errors }}
    <label class="field"><span>{{ 'customer.password' | t }}</span><input type="password" name="customer[password]" autocomplete="new-password" required></label>
    <label class="field"><span>{{ 'customer.password_confirm' | t }}</span><input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
    <button type="submit" class="btn btn--primary">{{ 'customer.reset' | t }}</button>
  {%- endform -%}
</div></section>

{% schema %}
{
  "name": "Nouveau mot de passe",
  "settings": []
}
{% endschema %}
