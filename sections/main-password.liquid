<section class="password">
  <div class="password__inner">
    <span class="header__logo-text">{{ shop.name }}</span>
    <h1 class="display">{{ 'password.title' | t }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password', class: 'password__form' -%}
      {{ form.errors | default_errors }}
      <label class="visually-hidden" for="Password">{{ 'password.label' | t }}</label>
      <input type="password" name="password" id="Password" placeholder="{{ 'password.label' | t }}" autocomplete="current-password">
      <button type="submit" class="btn btn--primary">{{ 'password.enter' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Mot de passe",
  "settings": []
}
{% endschema %}
