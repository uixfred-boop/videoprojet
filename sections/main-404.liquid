<section class="page-section notfound">
  <div class="page-width page-width--narrow notfound__inner">
    {% render 'gummy', class: 'notfound__gummy' %}
    <h1 class="display page-title">{{ 'general.404_title' | t }}</h1>
    <p>{{ 'general.404_text' | t }}</p>
    <a class="btn btn--primary btn--3d" href="{{ routes.root_url }}">{{ 'general.back_home' | t }}</a>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "settings": []
}
{% endschema %}
