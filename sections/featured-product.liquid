{%- assign product = section.settings.product -%}
<section class="product-section" id="buy" style="--ps-bg: {{ section.settings.bg }};">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="display product-section__title">{{ section.settings.heading }}{% if section.settings.heading_2 != blank %}<br>{{ section.settings.heading_2 }}{% endif %}</h2>
    {%- endif -%}
    {%- if product != blank -%}
      {% render 'buybox', section: section, product: product %}
    {%- else -%}
      <p class="product-section__empty">{{ 'product.choose_product' | t }}</p>
    {%- endif -%}
  </div>
</section>

