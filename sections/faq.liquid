<section class="faq" style="--faq-bg: {{ section.settings.bg }};">
  <div class="faq__inner page-width">
    <div class="faq__intro">
      <h2 class="faq__title">{{ section.settings.title }}</h2>
      {%- if section.settings.text != blank -%}<div class="faq__text">{{ section.settings.text }}</div>{%- endif -%}
    </div>
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="accordion accordion--lg" {{ block.shopify_attributes }}>
          <summary class="accordion__summary">{{ block.settings.question }}<span class="accordion__icon" aria-hidden="true"></span></summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
  {%- if section.settings.schema_markup and section.blocks.size > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for block in section.blocks -%}
            { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "FAQ",
  "class": "section-faq",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Encore des questions ?" },
    { "type": "richtext", "id": "text", "label": "Texte" },
    { "type": "checkbox", "id": "schema_markup", "label": "Données structurées FAQ (SEO)", "default": true },
    { "type": "color", "id": "bg", "label": "Fond", "default": "#EAF6FE" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Comment prendre Day Up ?" },
        { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>2 gummies le matin pour bien démarrer, ou 1 le matin et 1 l'après-midi.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }] }]
}
{% endschema %}
