<section class="page-section">
  <div class="page-width">
    <h1 class="display page-title">{{ 'search.title' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <label class="visually-hidden" for="SearchQ">{{ 'search.title' | t }}</label>
      <input id="SearchQ" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
      <button type="submit" class="btn btn--primary">{{ 'search.submit' | t }}</button>
    </form>
    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        <ul class="search-results" role="list">
          {%- for item in search.results -%}
            <li><a href="{{ item.url }}">{{ item.title }}</a></li>
          {%- else -%}
            <li>{{ 'search.no_results' | t: terms: search.terms }}</li>
          {%- endfor -%}
        </ul>
        {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Recherche",
  "settings": []
}
{% endschema %}
